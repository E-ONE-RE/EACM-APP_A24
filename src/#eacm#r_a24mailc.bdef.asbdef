managed implementation in class /EACM/BP_R_A24MAILC unique;
strict ( 2 );
with draft;
extensible;
define behavior for /EACM/R_A24MAILC alias /eacm/rA24mailc
persistent table /EACM/A24MAILC
extensible
draft table /EACM/A24MAILC_D
etag master LastChangedAt
lock master total etag LocalLastChangedAt
authorization master( global )
{
  field ( mandatory : create )
   ConfigID;

  field ( readonly )
   CreatedBy,
   CreatedAt,
   LastChangedBy,
   LastChangedAt,
   LocalLastChangedAt;

  field ( readonly : update )
   ConfigID;


  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for /EACM/A24MAILC corresponding extensible
  {
    ConfigID = CONFIG_ID;
    Active = ACTIVE;
    SendMode = SEND_MODE;
    Recipient = RECIPIENT;
    Sender = SENDER;
    SubjectPrefix = SUBJECT_PREFIX;
    CreatedBy = CREATED_BY;
    CreatedAt = CREATED_AT;
    LastChangedBy = LAST_CHANGED_BY;
    LastChangedAt = LAST_CHANGED_AT;
    LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
  }

}
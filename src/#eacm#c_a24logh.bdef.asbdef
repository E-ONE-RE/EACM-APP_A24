projection;
strict ( 2 );

define behavior for /EACM/C_A24LOGH alias Header
{
  use create;
  use update;
  //  use delete;

  use action ResetForReprocessing;

  use association _Items { create; }
  use association _Processes { create; }
}

define behavior for /EACM/C_A24LOGI alias Item
{
  use update;
  use delete;

  use association _Header;
}

define behavior for /EACM/C_A24LOGP alias Process
{
  use update;
  use delete;

  use association _Header;
}